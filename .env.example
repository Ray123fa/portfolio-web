# Application Environment
# Set to "local" for development, "prod" for production
NEXT_PUBLIC_ENV=prod

# Backend API Configuration (Non-public, stays on server)
# Use these for your upstream portfolio API
API_BASE_URL_LOCAL=https://showporto.test
API_BASE_URL_PROD=https://showporto.rfaridh.my.id
API_TOKEN=your_api_token_here

# Email Service (Resend)
# Get your API key from https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# Captcha Token Signing Secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAPTCHA_TOKEN_SECRET=your_captcha_secret_here
